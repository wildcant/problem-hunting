{
  "extraKnownMarketplaces": {
    "last30days-skill": {
      "source": "github",
      "repo": "mvanhorn/last30days-skill"
    }
  },
  "enabledPlugins": {
    "last30days@last30days-skill": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh"
          }
        ]
      }
    ]
  }
}
